{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kodu-record",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static Assets: files in public/ are served by CF edge.
  // run_worker_first: true routes all requests through the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Shares the same D1 database as kodu-repair and all KODU products.
  // All products point at kodu-core-db — schema is shared, isolated by app column.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kodu-core-db",
      "database_id": "8ccb390f-893f-4314-9dff-a3b16eb3092c"
    }
  ],

  // Environment variables (non-secret)
  "vars": {
    "ENVIRONMENT": "development",
    "APP_VERSION": "0.1.0"
  }

  // Secrets (set via `wrangler secret put`):
  //   MAILGUN_API_KEY            — Mailgun API key
  //   MAILGUN_DOMAIN             — Mailgun sending domain (e.g. mg.kodu.com)
  //   MAILGUN_FROM_NAME          — Sender name (e.g. "KODU Record")
  //   MAILGUN_FROM_EMAIL         — Sender address (e.g. hello@mg.kodu.com)
  //   MAILGUN_WEBHOOK_SIGNING_KEY — From Mailgun dashboard → Webhooks
}
